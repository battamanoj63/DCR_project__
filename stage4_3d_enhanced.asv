clc;
clear;
close all;

%% ============================================================
% STAGE 4
% 3D DYNAMIC USV SIMULATION
%
% A* + Custom KNN + PID
% Dynamic obstacles
% Wind + current + waves
% Adaptive collision avoidance
%
% No external dataset
% No Statistics and Machine Learning Toolbox
% =============================================================

fprintf('\n============================================\n');
fprintf(' STAGE 4 - 3D USV + KNN COLLISION AVOIDANCE\n');
fprintf('============================================\n');

%% Required files

if ~isfile('astar_path.mat')

    error('astar_path.mat not found. Run Stage 2 first.');

end

if ~isfile('knn_risk_model.mat')

    error('knn_risk_model.mat not found. Run Stage 2 first.');

end

%% Load

A = load('astar_path.mat');
M = load('knn_risk_model.mat');

path = A.path;
map = A.map;
target = A.target;
start = A.start;

knnModel = M.knnModel;

%% ============================================================
% PARAMETERS
% =============================================================

dt = 0.15;
T = 250;

t = 0:dt:T;
N = length(t);

uNom = 1.2;

maxYawRate = 0.7;

%% PID

Kp = 2.8;
Ki = 0.01;
Kd = 0.40;

integralError = 0;
previousError = 0;

%% Sea condition

seaCondition = 'moderate';

switch lower(seaCondition)

    case 'calm'

        windMean = 2;
        currentBase = 0.15;
        waveAmp = 0.15;

    case 'moderate'

        windMean = 4;
        currentBase = 0.30;
        waveAmp = 0.30;

    case 'rough'

        windMean = 7;
        currentBase = 0.50;
        waveAmp = 0.55;

end

%% ============================================================
% USV STATE
% =============================================================

x = zeros(1,N);
y = zeros(1,N);

heading = zeros(1,N);

heave = zeros(1,N);
roll = zeros(1,N);
pitch = zeros(1,N);

speedLog = zeros(1,N);

riskProbabilityLog = zeros(1,N);
riskLog = zeros(1,N);

avoidanceLog = zeros(1,N);

minSeparationLog = zeros(1,N);

%% Initial state

x(1) = start(1);
y(1) = start(2);

heading(1) = atan2( ...
    target(2)-start(2), ...
    target(1)-start(1));

%% ============================================================
% DYNAMIC OBSTACLES
% =============================================================

obstacleX = [25 45 65 30 75];

obstacleY = [25 55 35 75 70];

obstacleSize = [7 6 8 7 6];

obstacleSpeed = [ ...
    0.35
    0.45
    0.30
    0.55
    0.40];

obstacleDirection = deg2rad([ ...
    20
    145
    250
    315
    80]);

numObstacles = length(obstacleX);

%% ============================================================
% OBSTACLE LOG
% =============================================================

obstacleXLog = zeros(numObstacles,N);
obstacleYLog = zeros(numObstacles,N);

%% ============================================================
% MAIN SIMULATION
% =============================================================

reached = false;
collisionCount = 0;

for k = 1:N-1

    tk = t(k);

    %% --------------------------------------------------------
    % Environment
    % ---------------------------------------------------------

    windAngle = deg2rad(35);

    windMagnitude = ...
        windMean + ...
        1.0*sin(0.10*tk) + ...
        0.5*sin(0.31*tk);

    windX = windMagnitude*cos(windAngle);
    windY = windMagnitude*sin(windAngle);

    currentX = currentBase*cos(0.07*tk);
    currentY = currentBase*sin(0.05*tk);

    %% --------------------------------------------------------
    % Update dynamic obstacles
    % ---------------------------------------------------------

    for i = 1:numObstacles

        obstacleX(i) = ...
            obstacleX(i) + ...
            obstacleSpeed(i)* ...
            cos(obstacleDirection(i))*dt;

        obstacleY(i) = ...
            obstacleY(i) + ...
            obstacleSpeed(i)* ...
            sin(obstacleDirection(i))*dt;

        %% Reflect from boundaries

        if obstacleX(i) < 5 || obstacleX(i) > 95

            obstacleDirection(i) = ...
                pi-obstacleDirection(i);

            obstacleX(i) = ...
                max(5,min(95,obstacleX(i)));

        end

        if obstacleY(i) < 5 || obstacleY(i) > 95

            obstacleDirection(i) = ...
                -obstacleDirection(i);

            obstacleY(i) = ...
                max(5,min(95,obstacleY(i)));

        end

        obstacleXLog(i,k) = obstacleX(i);
        obstacleYLog(i,k) = obstacleY(i);

    end

    %% --------------------------------------------------------
    % Find nearest dynamic obstacle
    % ---------------------------------------------------------

    minDistance = inf;
    nearestIndex = 1;

    for i = 1:numObstacles

        d = hypot( ...
            obstacleX(i)-x(k), ...
            obstacleY(i)-y(k));

        if d < minDistance

            minDistance = d;
            nearestIndex = i;

        end

    end

    %% --------------------------------------------------------
    % Desired heading from A* path
    % ---------------------------------------------------------

    distances = hypot( ...
        path(:,1)-x(k), ...
        path(:,2)-y(k));

    [~,nearestPathIndex] = min(distances);

    lookAhead = 5;

    lookIndex = nearestPathIndex;

    while lookIndex < size(path,1)

        dPath = hypot( ...
            path(lookIndex,1)-x(k), ...
            path(lookIndex,2)-y(k));

        if dPath >= lookAhead
            break;
        end

        lookIndex = lookIndex + 1;

    end

    lookIndex = min(lookIndex,size(path,1));

    goalPoint = path(lookIndex,:);

    desiredHeading = atan2( ...
        goalPoint(2)-y(k), ...
        goalPoint(1)-x(k));

    headingError = wrap_pi( ...
        desiredHeading-heading(k));

    headingErrorDeg = rad2deg(headingError);

    %% --------------------------------------------------------
    % Dynamic obstacle relative velocity
    % ---------------------------------------------------------

    ox = obstacleX(nearestIndex);
    oy = obstacleY(nearestIndex);

    obsVx = obstacleSpeed(nearestIndex) * ...
        cos(obstacleDirection(nearestIndex));

    obsVy = obstacleSpeed(nearestIndex) * ...
        sin(obstacleDirection(nearestIndex));

    usvVx = uNom*cos(heading(k));
    usvVy = uNom*sin(heading(k));

    dx = ox-x(k);
    dy = oy-y(k);

    distance = hypot(dx,dy);

    relativeVx = obsVx-usvVx;
    relativeVy = obsVy-usvVy;

    if distance > 0.1

        closingSpeed = ...
            -(relativeVx*dx + ...
              relativeVy*dy)/distance;

    else

        closingSpeed = 10;

    end

    closingSpeed = max(0,closingSpeed);

    %% --------------------------------------------------------
    % TTC
    % ---------------------------------------------------------

    if closingSpeed > 0.05

        TTC = distance/closingSpeed;

    else

        TTC = 60;

    end

    TTC = min(TTC,60);

    %% --------------------------------------------------------
    % Relative angle
    % ---------------------------------------------------------

    obstacleBearing = atan2(dy,dx);

    relativeAngle = rad2deg( ...
        wrap_pi(obstacleBearing-heading(k)));

    %% --------------------------------------------------------
    % ML FEATURE VECTOR
    % ---------------------------------------------------------

    windSpeed = hypot(windX,windY);

    currentSpeed = hypot(currentX,currentY);

    features = [
        distance
        closingSpeed
        relativeAngle
        windSpeed
        currentSpeed
        headingErrorDeg
        TTC
    ];

    %% --------------------------------------------------------
    % KNN prediction
    % ---------------------------------------------------------

    [riskLabel,riskProbability] = ...
        knn_predict(knnModel,features);

    riskLog(k) = riskLabel;

    riskProbabilityLog(k) = riskProbability;

    %% --------------------------------------------------------
    % Adaptive avoidance
    % ---------------------------------------------------------

    if riskProbability >= 0.75

        avoidanceStrength = 5.0;

        desiredSpeed = 0.55;

        lookAhead = 10;

    elseif riskProbability >= 0.50

        avoidanceStrength = 3.5;

        desiredSpeed = 0.75;

        lookAhead = 8;

    else

        avoidanceStrength = 1.5;

        desiredSpeed = uNom;

        lookAhead = 5;

    end

    avoidanceLog(k) = avoidanceStrength;

    %% --------------------------------------------------------
    % Recalculate path target with adaptive lookahead
    % ---------------------------------------------------------

    lookIndex = nearestPathIndex;

    while lookIndex < size(path,1)

        dPath = hypot( ...
            path(lookIndex,1)-x(k), ...
            path(lookIndex,2)-y(k));

        if dPath >= lookAhead
            break;
        end

        lookIndex = lookIndex + 1;

    end

    lookIndex = min(lookIndex,size(path,1));

    goalPoint = path(lookIndex,:);

    desiredHeading = atan2( ...
        goalPoint(2)-y(k), ...
        goalPoint(1)-x(k));

    %% --------------------------------------------------------
    % Potential-field avoidance
    % ---------------------------------------------------------

    avoidanceX = 0;
    avoidanceY = 0;

    for i = 1:numObstacles

        dxo = x(k)-obstacleX(i);
        dyo = y(k)-obstacleY(i);

        dObs = hypot(dxo,dyo);

        influenceDistance = 18;

        if dObs < influenceDistance && dObs > 0.1

            force = avoidanceStrength * ...
                (1/dObs - 1/influenceDistance) / ...
                (dObs^2);

            avoidanceX = ...
                avoidanceX + force*dxo/dObs;

            avoidanceY = ...
                avoidanceY + force*dyo/dObs;

        end

    end

    %% Static obstacle avoidance

    [staticAvoidX,staticAvoidY] = ...
        static_obstacle_force( ...
        [x(k),y(k)],map,avoidanceStrength);

    avoidanceX = avoidanceX + staticAvoidX;
    avoidanceY = avoidanceY + staticAvoidY;

    %% Combine path and avoidance

    pathVectorX = cos(desiredHeading);
    pathVectorY = sin(desiredHeading);

    combinedX = ...
        pathVectorX + avoidanceX;

    combinedY = ...
        pathVectorY + avoidanceY;

    desiredHeading = atan2( ...
        combinedY,combinedX);

    %% --------------------------------------------------------
    % PID
    % ---------------------------------------------------------

    error = wrap_pi( ...
        desiredHeading-heading(k));

    integralError = ...
        integralError + error*dt;

    integralError = ...
        max(-2,min(2,integralError));

    derivativeError = ...
        (error-previousError)/dt;

    previousError = error;

    yaw = ...
        Kp*error + ...
        Ki*integralError + ...
        Kd*derivativeError;

    yaw = max( ...
        -maxYawRate, ...
        min(maxYawRate,yaw));

    %% --------------------------------------------------------
    % Update heading
    % ---------------------------------------------------------

    heading(k+1) = ...
        heading(k) + yaw*dt;

    %% --------------------------------------------------------
    % Wave disturbance
    % ---------------------------------------------------------

    waveElevation = ...
        waveAmp*sin(0.20*tk) + ...
        0.4*waveAmp*sin(0.37*tk);

    heave(k) = waveElevation;

    roll(k) = ...
        0.5*waveElevation*sin(0.13*tk);

    pitch(k) = ...
        0.4*waveElevation*cos(0.16*tk);

    waveX = ...
        0.05*waveElevation;

    waveY = ...
        0.05*waveElevation;

    %% --------------------------------------------------------
    % USV motion
    % ---------------------------------------------------------

    velocityX = ...
        desiredSpeed*cos(heading(k)) + ...
        currentX + ...
        0.015*windX + ...
        waveX + ...
        avoidanceX;

    velocityY = ...
        desiredSpeed*sin(heading(k)) + ...
        currentY + ...
        0.015*windY + ...
        waveY + ...
        avoidanceY;

    x(k+1) = ...
        x(k) + velocityX*dt;

    y(k+1) = ...
        y(k) + velocityY*dt;

    %% Keep inside map

    x(k+1) = ...
        max(1,min(99,x(k+1)));

    y(k+1) = ...
        max(1,min(99,y(k+1)));

    %% --------------------------------------------------------
    % Separation / collision
    % ---------------------------------------------------------

    minSeparation = inf;

    for i = 1:numObstacles

        d = hypot( ...
            obstacleX(i)-x(k+1), ...
            obstacleY(i)-y(k+1));

        d = d-obstacleSize(i);

        minSeparation = min( ...
            minSeparation,d);

        if d <= 0

            collisionCount = collisionCount + 1;

        end

    end

    minSeparationLog(k) = minSeparation;

    %% --------------------------------------------------------
    % Target reached
    % ---------------------------------------------------------

    targetDistance = ...
        hypot(target(1)-x(k+1), ...
              target(2)-y(k+1));

    if targetDistance <= 3

        reached = true;

        x(k+1:end) = x(k+1);
        y(k+1:end) = y(k+1);

        heading(k+1:end) = heading(k+1);

        break;

    end

end

%% ============================================================
% RESULTS
% =============================================================

lastIndex = find(x ~= 0,1,'last');

if isempty(lastIndex)

    lastIndex = N;

end

finalDistance = ...
    hypot(target(1)-x(lastIndex), ...
          target(2)-y(lastIndex));

travelledDistance = 0;

for k = 2:lastIndex

    travelledDistance = ...
        travelledDistance + ...
        hypot(x(k)-x(k-1), ...
              y(k)-y(k-1));

end

validRisk = ...
    riskProbabilityLog(1:lastIndex);

validRisk = validRisk(validRisk > 0);

if isempty(validRisk)

    maxRisk = 0;
    averageRisk = 0;

else

    maxRisk = max(validRisk);
    averageRisk = mean(validRisk);

end

fprintf('\n============================================\n');
fprintf(' STAGE 4 RESULTS\n');
fprintf('============================================\n');

fprintf('Final distance       : %.3f m\n',finalDistance);
fprintf('Travelled distance   : %.3f m\n',travelledDistance);
fprintf('Maximum ML risk      : %.3f\n',maxRisk);
fprintf('Average ML risk      : %.3f\n',averageRisk);
fprintf('Collision count      : %d\n',collisionCount);

if reached
    fprintf('Target reached       : YES\n');
else
    fprintf('Target reached       : NO\n');
end

%% ============================================================
% 3D FIGURE
% =============================================================

figure('Name','Stage 4 - 3D Autonomous USV');

hold on;
grid on;
axis equal;

xlim([0 100]);
ylim([0 100]);
zlim([-2 5]);

xlabel('X (m)');
ylabel('Y (m)');
zlabel('Wave Height (m)');

view(45,35);

%% Water surface

[Xw,Yw] = meshgrid(0:4:100,0:4:100);

Zw = zeros(size(Xw));

surf(Xw,Yw,Zw, ...
    'FaceAlpha',0.25, ...
    'EdgeAlpha',0.1);

%% Static obstacles

[obsY,obsX] = find(map == 1);

scatter3(obsX,obsY, ...
    zeros(size(obsX)), ...
    15,'filled');

%% Planned path

plot3( ...
    path(:,1), ...
    path(:,2), ...
    zeros(size(path,1),1)+0.2, ...
    'g--','LineWidth',2);

%% USV trajectory

plot3( ...
    x(1:lastIndex), ...
    y(1:lastIndex), ...
    heave(1:lastIndex)+0.5, ...
    'b-','LineWidth',2);

%% Dynamic obstacle trajectories

for i = 1:numObstacles

    plot3( ...
        obstacleXLog(i,1:lastIndex), ...
        obstacleYLog(i,1:lastIndex), ...
        zeros(1,lastIndex)+0.4, ...
        'r--');

end

%% Start / target

plot3(start(1),start(2),0.5, ...
    'ko','MarkerSize',10,'LineWidth',2);

plot3(target(1),target(2),0.5, ...
    'mx','MarkerSize',14,'LineWidth',3);

title('3D Autonomous USV Navigation');

legend('Water','Static Obstacles', ...
       'A* Path','USV Trajectory', ...
       'Dynamic Obstacles');

%% ============================================================
% ML RISK FIGURE
% =============================================================

figure('Name','Stage 4 - KNN Risk');

plot( ...
    t(1:lastIndex), ...
    riskProbabilityLog(1:lastIndex), ...
    'LineWidth',1.5);

hold on;

yline(0.5,'--');
yline(0.75,'--');

xlabel('Time (s)');
ylabel('Collision Risk Probability');

title('Custom KNN Collision Risk Prediction');

legend('Risk Probability', ...
       'Medium Risk','High Risk');

grid on;

%% ============================================================
% SPEED FIGURE
% =============================================================

figure('Name','Stage 4 - Adaptive Speed');

plot( ...
    t(1:lastIndex), ...
    speedLog(1:lastIndex), ...
    'LineWidth',1.5);

xlabel('Time (s)');
ylabel('Speed (m/s)');

title('ML Adaptive USV Speed');

grid on;

%% ============================================================
% SEPARATION FIGURE
% =============================================================

figure('Name','Stage 4 - Obstacle Separation');

plot( ...
    t(1:lastIndex), ...
    minSeparationLog(1:lastIndex), ...
    'LineWidth',1.5);

yline(0,'--');

xlabel('Time (s)');
ylabel('Minimum Separation (m)');

title('Dynamic Obstacle Clearance');

grid on;

%% ============================================================
% SAVE
% =============================================================

stage4Results.x = x;
stage4Results.y = y;
stage4Results.heading = heading;

stage4Results.risk = riskLog;
stage4Results.riskProbability = riskProbabilityLog;

stage4Results.speed = speedLog;
stage4Results.avoidance = avoidanceLog;

stage4Results.minSeparation = minSeparationLog;

stage4Results.finalDistance = finalDistance;
stage4Results.travelledDistance = travelledDistance;

stage4Results.collisionCount = collisionCount;
stage4Results.reached = reached;

save('stage4_results.mat','stage4Results');

fprintf('\nSaved: stage4_results.mat\n');

%% ============================================================
% FUNCTIONS
% =============================================================

function [label,probability] = knn_predict(model,x)

    xNorm = ...
        (x(:)' - model.mu) ./ model.sigma;

    distances = sqrt( ...
        sum((model.Xtrain-xNorm).^2,2));

    [~,idx] = sort(distances,'ascend');

    K = min(model.K,length(idx));

    nearest = idx(1:K);

    probability = ...
        mean(model.Ytrain(nearest));

    label = probability >= 0.5;

end

function a = wrap_pi(a)

    a = mod(a+pi,2*pi)-pi;

end

function [Fx,Fy] = static_obstacle_force( ...
    position,map,strength)

    Fx = 0;
    Fy = 0;

    [oy,ox] = find(map == 1);

    influenceDistance = 10;

    for i = 1:length(ox)

        dx = position(1)-ox(i);
        dy = position(2)-oy(i);

        d = hypot(dx,dy);

        if d < influenceDistance && d > 0.1

            force = strength * ...
                (1/d - 1/influenceDistance) / ...
                (d^2);

            Fx = Fx + force*dx/d;
            Fy = Fy + force*dy/d;

        end

    end

end